{
  "name": "@thiscord/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "generate:policies": "node scripts/generate-policies.mjs",
    "check:policies": "node scripts/generate-policies.mjs --check",
