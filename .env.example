# The static frontend can live on GitHub Pages or any static host.
FRONTEND_URL=https://username.github.io/thiscord

# Public backend DNS names. Point these records at the VPS.
POCKETBASE_DOMAIN=api.example.com
JITSI_DOMAIN=meet.example.com
TURN_DOMAIN=turn.example.com
ACME_EMAIL=admin@example.com

# Public IP advertised by Jitsi Videobridge and Coturn.
JVB_ADVERTISE_IPS=203.0.113.10
TZ=UTC
POCKETBASE_BIND=127.0.0.1:8090

# CORS is not an authentication boundary. "*" supports the PWA, localhost
# development, and the Electron client's loopback origin.
POCKETBASE_ORIGINS=*

# Generated by `npm run setup:self-host -- --frontend-url ...`.
JITSI_APP_ID=thiscord
JITSI_APP_SECRET=CHANGE_ME_JITSI_APP_SECRET
JICOFO_AUTH_PASSWORD=CHANGE_ME_JICOFO_AUTH_PASSWORD
JVB_AUTH_PASSWORD=CHANGE_ME_JVB_AUTH_PASSWORD
TURN_PASSWORD=CHANGE_ME_TURN_PASSWORD

# Desktop packaging and updates.
APP_ID=chat.thiscord.app
APP_NAME=Thiscord
APP_PROTOCOL=thiscord
UPDATE_PROVIDER=none
UPDATE_URL=
RELEASE_CHANNEL=latest
